# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Directory where uploaded batch files are stored
# Used by both FastAPI service and workers to access batch request files
UPLOAD_FOLDER=/tmp/batch_files

# Secret key for signing sessions/JWT tokens (CURRENTLY NOT USED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Nginx configuration file to use (e.g., nginx-8gpu.conf, nginx-24gpu.conf)
NGINX_CONF=nginx-8gpu.conf

# Remote cluster host IPs for multi-cluster deployments (optional)
REMOTE_CLUSTER_HOST_A=
REMOTE_CLUSTER_HOST_B=

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL database credentials
# Used by: postgres service, fast-api service, worker service
POSTGRES_USER=batch
POSTGRES_PASSWORD=batch
POSTGRES_DB=batch

# ==============================================================================
# vLLM / MODEL SERVICE CONFIGURATION
# ==============================================================================

# Base URL for OpenAI-compatible API (points to nginx load balancer)
# Used by YOUR services (workers) to send requests TO vLLM servers
OPENAI_API_BASE=http://localhost:8000/v1

# API key that YOUR services use to authenticate WITH vLLM servers
# Direction: Your FastAPI/Workers → vLLM Servers
OPENAI_API_KEY=dummy-key

# Same as OPENAI_API_KEY - used in docker-compose for vLLM server configuration
VLLM_API_KEY=dummy-key

# API key for testing against external LLM services (optional)
# When TESTING=active, this overrides OPENAI_API_KEY to test with real providers
TEST_API_KEY=

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================

# Path to local model files (mounted into vLLM containers)
MODEL_PATH=/path/to/your/model

# Model name to serve (used by vLLM --served-model-name)
SERVED_MODEL_NAME=your-model-name

# HuggingFace token for downloading models from HuggingFace Hub
HUGGING_FACE_HUB_TOKEN=

# ==============================================================================
# AUTHENTICATION - CLIENT ACCESS TO YOUR API
# ==============================================================================

# Basic Auth credentials for accessing the web UI
# Clients must provide these when visiting the static web interface
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=changeme

# API key that CLIENTS use to authenticate WITH YOUR FastAPI service
# Direction: External Clients → Your FastAPI Service
# Clients include this in requests: Authorization: Bearer <API_KEY>
API_KEY=your-client-api-key-change-in-production

# ==============================================================================
# KEY DIFFERENCES EXPLAINED
# ==============================================================================
# 
# API_KEY:          Client → Your API (inbound auth)
# OPENAI_API_KEY:   Your API → vLLM (outbound auth)
# SECRET_KEY:       Internal crypto (not currently used)
#